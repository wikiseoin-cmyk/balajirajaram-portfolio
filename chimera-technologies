    <style>

        :root {
            --navy: #0b2d57;
            --blue: #1266d6;
            --cyan: #00a8df;
            --light-blue: #eef6ff;
            --text: #172033;
            --muted: #64748b;
            --white: #ffffff;
            --border: #dce7f3;
            --bg: #f8fbff;
            --dark: #071d38;
            --shadow: 0 15px 40px rgba(11,45,87,0.08);
