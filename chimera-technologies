        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .container {
            width: min(1120px, 92%);
            margin: auto;
        }

        /* Navigation */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .nav {
            min-height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--navy);
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--blue);
        }

        .nav-links {
            display: flex;
            gap: 24px;
            list-style: none;
            font-size: 14px;
            font-weight: 600;
            color: #334155;
        }

        .nav-links a:hover {
            color: var(--blue);
        }

        /* Hero */

        .hero {
            padding: 95px 0 80px;
            background:
                radial-gradient(circle at 80% 20%, rgba(0,168,223,0.12), transparent 30%),
                linear-gradient(135deg, #f7fbff 0%, #ffffff 55%, #edf7ff 100%);
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
            border-radius: 30px;
            background: #e6f3ff;
            color: var(--blue);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .hero h1 {
            max-width: 900px;
            font-size: clamp(38px, 6vw, 68px);
            line-height: 1.08;
            letter-spacing: -2.5px;
            color: var(--navy);
            margin-bottom: 24px;
        }

        .hero h1 span {
            color: var(--blue);
        }

        .hero-lead {
            max-width: 800px;
            font-size: 19px;
            color: #475569;
            margin-bottom: 30px;
        }

        .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .meta {
            padding: 10px 16px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--navy);
        }

        /* Stats */

        .stats {
            margin-top: -35px;
            position: relative;
            z-index: 5;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .stat {
            background: white;
            padding: 25px;
            border-radius: 14px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }

        .stat strong {
            display: block;
            font-size: 30px;
            color: var(--blue);
            line-height: 1.2;
            margin-bottom: 7px;
        }

        .stat span {
            font-size: 13px;
            color: var(--muted);
        }

        /* Sections */

        section {
            padding: 90px 0;
        }

        .section-label {
            color: var(--blue);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        h2 {
            font-size: clamp(30px, 4vw, 44px);
            color: var(--navy);
            line-height: 1.2;
            letter-spacing: -1px;
            margin-bottom: 20px;
        }

        .section-intro {
            max-width: 780px;
            color: var(--muted);
            margin-bottom: 40px;
        }

        /* Company */

        .company-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: start;
        }

        .company-card {
            background: white;
            padding: 34px;
            border-radius: 18px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }

        .company-card h3 {
            color: var(--navy);
            font-size: 23px;
            margin-bottom: 15px;
        }

        .company-card p {
            color: #526176;
            margin-bottom: 16px;
        }

        .entity-list {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 20px;
        }

        .tag {
            background: var(--light-blue);
            color: var(--navy);
            padding: 7px 11px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
        }

        /* Services */

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .service-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 27px;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .service-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow);
        }

        .service-number {
            color: var(--cyan);
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .service-card h3 {
            font-size: 18px;
            color: var(--navy);
            margin-bottom: 10px;
        }

        .service-card p {
            color: var(--muted);
            font-size: 14px;
        }

        /* Industries */

        .industry-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
        }

        .industry {
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 25px 15px;
            text-align: center;
            font-weight: 700;
            color: var(--navy);
        }

        .industry small {
            display: block;
            margin-top: 7px;
            color: var(--muted);
            font-weight: 400;
            font-size: 11px;
        }

        /* Contribution */

        .contribution {
            background: var(--navy);
            color: white;
        }

        .contribution h2 {
            color: white;
        }

        .contribution .section-intro {
            color: #cbd8e8;
        }

        .contribution-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .contribution-card {
            padding: 28px;
            border: 1px solid rgba(255,255,255,0.14);
            border-radius: 14px;
            background: rgba(255,255,255,0.06);
        }

        .contribution-card h3 {
            font-size: 18px;
            margin-bottom: 12px;
            color: white;
        }

        .contribution-card p {
            color: #d5dfec;
            font-size: 14px;
        }

        .contribution-card ul {
            margin-top: 12px;
            padding-left: 19px;
            color: #d5dfec;
            font-size: 14px;
        }

        .contribution-card li {
            margin-bottom: 7px;
        }

        /* Timeline */

        .timeline {
            position: relative;
            margin-top: 40px;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 90px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .timeline-item {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 35px;
            position: relative;
            margin-bottom: 35px;
        }

        .timeline-year {
            font-weight: 800;
            color: var(--blue);
            font-size: 14px;
        }

        .timeline-content {
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(11,45,87,0.04);
        }

        .timeline-content h3 {
            color: var(--navy);
            font-size: 18px;
            margin-bottom: 10px;
        }

        .timeline-content ul {
            padding-left: 18px;
            color: var(--muted);
            font-size: 14px;
        }

        .timeline-content li {
            margin-bottom: 7px;
        }

        /* AI Search */

        .ai-box {
            background: linear-gradient(135deg, #edf7ff, #ffffff);
            border: 1px solid #cfe3f7;
            border-radius: 18px;
            padding: 40px;
        }

        .ai-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .ai-item {
            background: white;
            border-radius: 12px;
            padding: 23px;
            border: 1px solid var(--border);
        }

        .ai-item strong {
            display: block;
            color: var(--navy);
            margin-bottom: 8px;
        }

        .ai-item span {
            color: var(--muted);
            font-size: 13px;
        }

        /* FAQ */

        .faq {
            max-width: 900px;
        }

        details {
            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;
            margin-bottom: 12px;
            padding: 19px 22px;
        }

        summary {
            cursor: pointer;
            color: var(--navy);
            font-weight: 700;
        }

        details p {
            color: var(--muted);
            margin-top: 13px;
            font-size: 14px;
        }

        /* CTA */

        .cta {
            text-align: center;
            background: linear-gradient(135deg, #edf7ff, #ffffff);
        }

        .cta p {
            max-width: 700px;
            margin: 0 auto 25px;
            color: var(--muted);
        }

        .btn {
            display: inline-block;
            padding: 13px 22px;
            background: var(--blue);
            color: white;
            border-radius: 8px;
            font-weight: 700;
            font-size: 14px;
        }

        .btn:hover {
            background: var(--navy);
        }

        /* Footer */

        footer {
            background: #061a31;
            color: #a9b9cb;
            padding: 35px 0;
            font-size: 13px;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        footer strong {
            color: white;
        }

        /* Responsive */

        @media (max-width: 900px) {

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .industry-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .company-grid,
            .contribution-grid,
            .ai-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 650px) {

            .nav-links {
                display: none;
            }

            .hero {
                padding: 65px 0;
            }

            section {
                padding: 65px 0;
            }

            .stats-grid,
            .services-grid,
            .industry-grid {
                grid-template-columns: 1fr;
            }

            .timeline::before {
                display: none;
            }

            .timeline-item {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .footer-inner {
                flex-direction: column;
            }
        }

